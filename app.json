{
  "expo": {
    "name": "Talvori",
    "slug": "talvori",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "globalhousehold",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    }
  }
}
