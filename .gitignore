# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# ---------------------------------------------------------------------------
# SECRETS — never commit real environment files.
# Only `.env.example` (placeholder values) belongs in version control.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# local env files
*.local

# typescript
*.tsbuildinfo

# testing
coverage/

# generated native folders
/ios
/android

# agent skills (installed per-repo via `npx skills add`)
# .agents/ holds the skill content; .claude/skills/ are symlinks into it.
# skills-lock.json is intentionally NOT ignored so installs stay reproducible.
.agents/
.claude/skills/
.codex/
