# ===========================================================================
# Talvori — environment template
# ===========================================================================
# Copy this file to `.env` (git-ignored) and fill in real values per machine.
#
# RULE (see 02_NON_NEGOTIABLE_ARCHITECTURE_RULES.md):
#   ONLY publishable / client-safe values may use the EXPO_PUBLIC_ prefix.
#   The Supabase anon key is designed to be public and is protected by RLS.
#
#   NEVER place any of these in an EXPO_PUBLIC_ variable or in this repo:
#     - Supabase service role / secret key
#     - Stripe secret key
#     - SMS / FX / retailer partner secrets
#   Those belong only in server-side secret storage (Supabase Edge Functions).
# ===========================================================================

# Which environment this build targets: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project (client-safe values only)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
